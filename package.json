{
  "name": "ai-infra-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI 데이터센터(채굴→AI, 네오클라우드, 하이퍼스케일러, 한국) 현황을 전략게임풍 3D 지구본으로 보여주는 비공식 지도",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4175",
    "validate": "node scripts/validate-sites.mjs",
    "geo": "node scripts/build-land-hex.mjs && node scripts/build-borders.mjs",
    "geo:fetch": "node scripts/fetch-natural-earth.mjs",
    "prebuild": "npm run validate",
    "postbuild": "node scripts/check-size.mjs",
    "test": "vitest run",
    "record": "npm run build && node scripts/record-server.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "lucide-react": "^1.52.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "h3-js": "^4.5.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "world-atlas": "^2.0.2"
  }
}
